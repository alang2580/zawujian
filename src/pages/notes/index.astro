---
/**
 * 笔记列表页
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContentList from '../../components/ContentList.astro';

const items = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="笔记" description="长文、踩坑复盘、以及一些没地方放的思考。">
  <header class="page-head">
    <div class="wrap">
      <span class="tag">笔记 / Notes</span>
      <h1>想清楚再写</h1>
      <p>比推荐更长的东西：一次完整的踩坑复盘、一个想法的推演过程、一年的总结。</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {
        items.length > 0 ? (
          <ContentList
            items={items.map((n) => ({
              href: `/notes/${n.id}`,
              category: '笔记',
              tone: 'ink' as const,
              title: n.data.title,
              summary: n.data.summary,
              meta: fmt(n.data.publishedAt),
            }))}
          />
        ) : (
          <p class="empty">还没有笔记。往 <code>src/content/notes/</code> 里放一个 Markdown 文件就会出现。</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .empty { color: var(--muted); font-size: 14px; padding: 20px 0; }
  .empty code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--paper-2);
    padding: 1px 5px;
  }
</style>
