---
/**
 * 藏品详情页
 * 五段式信息在正文之前单独成卡，读者可以先扫一眼判断值不值得看。
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const items = await getCollection('tools', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

interface Props {
  item: CollectionEntry<'tools'>;
}

const { item } = Astro.props;
const { Content } = await render(item);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// 五段式，顺序不能乱：先讲用途，再讲代价，最后给退路
const facts = [
  { label: '解决什么问题', value: item.data.problem },
  { label: '用了多久', value: item.data.usedFor },
  { label: '坑在哪', value: item.data.pitfall },
  { label: '什么时候别用', value: item.data.skipWhen },
  { label: '替代品', value: item.data.alternative },
];
---

<Base title={item.data.title} description={item.data.summary}>
  <article>
    <header class="detail-head">
      <div class="wrap">
        <div class="detail-head__top">
          <span class="tag">{item.data.category} / Tool</span>
          <span class="tag">{fmt(item.data.publishedAt)}</span>
        </div>
        <h1>{item.data.title}</h1>
        <p class="detail-head__summary">{item.data.summary}</p>

        <div class="detail-head__foot">
          <div class="score">
            <span class="score__num">{item.data.score}</span>
            <span class="score__total">/ 5</span>
          </div>
          <a class="visit" href={item.data.url} target="_blank" rel="noopener">
            打开官网 →
          </a>
        </div>
      </div>
    </header>

    <div class="wrap">
      <!-- 五段式速览 -->
      <section class="facts">
        {facts.map((f) => (
          <div class="fact">
            <div class="fact__label">{f.label}</div>
            <div class="fact__value">{f.value}</div>
          </div>
        ))}
      </section>

      <!-- 正文 -->
      <div class="prose detail-prose">
        <Content />
      </div>

      {item.data.tags.length > 0 && (
        <div class="tags">
          {item.data.tags.map((t) => (
            <span class="tags__item">#{t}</span>
          ))}
        </div>
      )}

      <Comments />
    </div>
  </article>
</Base>

<style>
  .detail-head {
    padding: 48px 0 36px;
    border-bottom: 3px solid var(--ink);
  }
  .detail-head__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 22px;
    gap: 12px;
  }
  .detail-head h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.4vw, 76px);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }
  .detail-head__summary {
    margin-top: 20px;
    font-size: 19px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 680px;
  }
  .detail-head__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 32px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .score { display: flex; align-items: baseline; gap: 4px; }
  .score__num {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--accent);
    line-height: 1;
  }
  .score__total {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .visit {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    border: 1.5px solid var(--ink);
    padding: 10px 18px;
    transition: background 0.18s, color 0.18s;
  }
  .visit:hover { background: var(--ink); color: var(--paper); }

  /* 五段式：两列网格，最后一项独占一行 */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-bottom: var(--line);
  }
  .fact {
    padding: 26px 28px 26px 0;
    border-top: var(--line);
  }
  .fact:nth-child(2n) {
    padding-left: 28px;
    border-left: var(--line);
  }
  .fact__label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .fact__value {
    font-size: 15.5px;
    line-height: 1.7;
    color: #232019;
  }

  .detail-prose {
    max-width: 720px;
    padding: 44px 0 0;
  }

  .tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 48px;
  }
  .tags__item {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 4px 10px;
  }

  @media (max-width: 900px) {
    .detail-head { padding: 32px 0 26px; }
    .detail-head__summary { font-size: 16.5px; }
    .facts { grid-template-columns: 1fr; }
    .fact, .fact:nth-child(2n) { padding: 20px 0; border-left: none; }
    .detail-prose { padding-top: 32px; }
  }
</style>
