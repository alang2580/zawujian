---
/**
 * 藏品列表页
 * 只显示未标记草稿的条目，按发布日期倒序。
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContentList from '../../components/ContentList.astro';

const items = (await getCollection('tools', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="藏品" description="我用过并留下的工具。每条都写了它解决什么问题、我用了多久、坑在哪、什么时候不该用它。">
  <header class="page-head">
    <div class="wrap">
      <span class="tag">藏品 / Collection</span>
      <h1>用过才留下</h1>
      <p>
        这里每一条都写了五件事：解决什么问题、我用了多久、坑在哪、什么情况下别用、替代品是谁。
        缺一件我就不会写进来。
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {
        items.length > 0 ? (
          <ContentList
            items={items.map((t) => ({
              href: `/tools/${t.id}`,
              category: t.data.category,
              tone: 'accent' as const,
              title: t.data.title,
              summary: t.data.summary,
              meta: `${fmt(t.data.publishedAt)} · 评分 ${t.data.score}`,
            }))}
          />
        ) : (
          <p class="empty">还没有条目。往 <code>src/content/tools/</code> 里放一个 Markdown 文件就会出现。</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .empty { color: var(--muted); font-size: 14px; padding: 20px 0; }
  .empty code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--paper-2);
    padding: 1px 5px;
  }
</style>
