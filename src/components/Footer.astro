---
/**
 * 页脚
 * 放联系方式、导航链接（对 SEO 和内链有用）、以及版权信息。
 */
import { SITE, NAV } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <span class="tag">联系 / Contact</span>

    <h2 class="footer__big rise">
      有想让我试的工具？<br />或者，发现了我的错。
    </h2>

    <a class="footer__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>

    <div class="footer__row">
      <nav class="footer__nav">
        {NAV.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href="/rss.xml">RSS</a>
      </nav>
      <span class="tag">{SITE.name} {SITE.nameEn} · 建于 {SITE.since}–{year}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 72px 0 40px;
    border-top: 3px solid var(--ink);
  }
  .footer__big {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 62px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 14px 0 26px;
  }
  .footer__mail {
    font-family: var(--font-mono);
    font-size: 14px;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 3px;
    color: var(--accent);
  }
  .footer__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 64px;
    padding-top: 22px;
    border-top: var(--line);
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer__nav {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }
  .footer__nav a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    transition: color 0.18s;
  }
  .footer__nav a:hover { color: var(--accent); }
  .footer__row .tag { font-size: 10.5px; }

  @media (max-width: 900px) {
    .footer { padding: 48px 0 32px; }
    .footer__row { margin-top: 40px; }
  }
</style>
